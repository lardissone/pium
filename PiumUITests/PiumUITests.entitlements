<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode's generated runner is sandboxed and its template grants only a
	     read-only exception for the filesystem, so a test that writes into the
	     real home silently lands in the runner's container instead — which is
	     where the plugin tests were writing while Pium, unsandboxed, read the
	     real folder. See PIUM-62. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
</dict>
</plist>
