    "bookmarks.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one with the + below, and it will turn up in the launcher as soon as you type its name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregá uno con el + de abajo y va a aparecer en el launcher apenas escribas su nombre."
          }
