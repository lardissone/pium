    "settings.search.clearHistoryExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pium! learns which results you pick so they come back first. Erasing this cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pium! aprende qué resultados elegís para mostrarlos primero. Borrar esto no se puede deshacer."
          }
        }
      }
    },
