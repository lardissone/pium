    "execution.failure.missingConfiguration %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has no value yet. Fill it in Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» todavía no tiene valor. Completalo en Ajustes"
          }
        }
      }
    },
    "execution.failure.notExecutable %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not executable. Give it permission with chmod +x"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es ejecutable. Dale permiso con chmod +x"
          }
        }
      }
    },
    "execution.failure.notFound %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find “%1$@”. Looked in: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró «%1$@». Se buscó en: %2$@"
          }
        }
      }
    },
    "execution.failure.quarantined %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS quarantined %@ because it was downloaded. Clear it with xattr -d com.apple.quarantine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS puso %@ en cuarentena porque se descargó. Quitala con xattr -d com.apple.quarantine"
          }
        }
      }
    },
    "execution.failure.secretUnavailable %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keychain would not give up the secret for “%@”"
