    "settings.search.excludedChooseMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the files and folders to keep out of file results"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegí los archivos y carpetas que no querés ver en los resultados"
          }
        }
      }
    },
    "settings.search.excludedExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name such as node_modules hides that folder wherever it is. A path hides one place and everything inside it. A pattern such as **/[Cc]ache/** hides whatever it matches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre como node_modules oculta esa carpeta esté donde esté. Una ruta oculta un solo lugar y todo lo que contiene. Un patrón como **/[Cc]ache/** oculta lo que coincida con él."
          }
        }
      }
    },
    "settings.search.excludedPlaceholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder name, path, or pattern"
          }
