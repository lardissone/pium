    "settings.advanced.debugWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug logging records what you type, the arguments you pass, the commands Pium runs, and what they print. Declared secrets are removed. A secret you type into a plugin's argument cannot be. Logging stops on its own after 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de depuración guarda lo que escribís, los argumentos que pasás, los comandos que Pium ejecuta y lo que imprimen. Los secretos declarados se quitan. Un secreto que escribas dentro del argumento de un plugin, no. El registro se apaga solo a las 24 horas."
          }
        }
      }
    },
    "settings.advanced.debugWarningTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on debug logging?"
