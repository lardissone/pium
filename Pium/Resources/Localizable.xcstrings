    "bookmark.destination.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bookmark needs a destination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un marcador necesita un destino."
          }
        }
      }
    },
    "bookmark.destination.unrecognized %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is neither a link nor a path. A link carries a scheme, like https:// or obsidian://; a path starts with / or ~."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es ni un enlace ni una ruta. Un enlace lleva un esquema, como https:// u obsidian://; una ruta empieza con / o ~."
          }
        }
      }
    },
    "bookmark.open.applicationMissing %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not installed, so this opened with the default application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no está instalada, así que esto se abrió con la aplicación por defecto."
          }
        }
      }
    },
    "bookmark.open.unopenable %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not something macOS can open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es algo que macOS pueda abrir."
          }
        }
      }
    },
    "bookmark.template.unclosed %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” opens {{ and never closes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» abre {{ y nunca lo cierra."
          }
        }
      }
    },
    "bookmark.template.unknownFilter %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a filter Pium knows. A bookmark takes raw, and encodes for you otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es un filtro que Pium conozca. Un marcador acepta raw, y si no, codifica por vos."
          }
        }
      }
    },
    "bookmark.template.unknownVariable %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not something Pium can fill in. The only one a bookmark takes is {{input}}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es algo que Pium pueda completar. Lo único que un marcador acepta es {{input}}."
          }
        }
      }
    },
