    "bookmarks.whatIsAbookmark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bookmark is something you name once and open from the launcher afterwards: a link, a file, a folder. Put {{input}} in the destination and Pium will ask you for a value before opening it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un marcador es algo que nombrás una vez y después abrís desde el launcher: un enlace, un archivo, una carpeta. Poné {{input}} en el destino y Pium te va a pedir un valor antes de abrirlo."
          }
        }
      }
    },
    "execution.failure.alreadyRunning %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is still running"
          }
        },
        "es": {
