    "settings.updates.automatic.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pium checks every six hours and tells you the next time you open it. It never installs an update on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pium comprueba cada seis horas y te avisa la próxima vez que lo abras. Nunca instala una actualización por su cuenta."
          }
        }
      }
    },
