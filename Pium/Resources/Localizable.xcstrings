            "value": "Agregar"
          }
        }
      }
    },
    "settings.advanced.pathExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the PATH a plugin's command runs with — not where Pium looks for applications or files, which is in Search. Directories added here are searched after Pium's own, so a plugin can find a tool the defaults miss without replacing one that already works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el PATH con el que se ejecuta el comando de un plugin — no es dónde Pium busca aplicaciones o archivos, que está en Búsqueda. Los directorios que agregues acá se buscan después de los de Pium, así un plugin puede encontrar una herramienta que falte sin reemplazar una que ya funciona."
          }
        }
      }
    },
