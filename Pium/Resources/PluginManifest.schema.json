{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pium.app/schemas/plugin-manifest-v1.json",
  "title": "Pium plugin manifest",
  "description": "One JSON file describes one searchable command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "command"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "description": "Stable, globally unique. Lowercase letters, digits, dot, and hyphen.",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "icon": { "type": "string", "description": "SF Symbol name. Unknown symbols fall back." },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["none", "optional", "required"] },
        "placeholder": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "workingDirectory": { "type": "string" }
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type", "environmentVariable"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["string", "secret"] },
          "required": { "type": "boolean" },
          "environmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["silent", "toast"] }
      }
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "confirmBeforeRun": { "type": "string", "minLength": 1 }
  }
}
